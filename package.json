{
  "name": "realmyfit",
  "private": true,
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "backend": "npm run start:dev --prefix backend",
    "frontend": "npm start --prefix frontend",
    "dev": "npx concurrently -n backend,frontend -c green,cyan \"npm run backend\" \"npm run frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
